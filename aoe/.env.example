# .env.example — Copy this file to .env and fill in your actual values.
# Don't commit .env to version control.

# OpenAI / LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-nano

# Gurobi
GUROBI_LICENSE_PATH=/path/to/gurobi.lic

# Development
USE_DUMMY_ANALYSER=true   # set to true to skip LLM calls during UI development
USE_DUMMY_LATEX_GENERATOR=true
USE_DUMMY_CODE_GENERATOR=true

TEST_ERROR_INJECTION=true # When TEST_ERROR_INJECTION=true, which error to simulate?
TEST_ERROR_TYPE=modeling_error # Options: syntax_error | runtime_error | modeling_error | unknown_error

# Logging
LOG_LEVEL=INFO
LOG_OUTPUT_DIR=./logs